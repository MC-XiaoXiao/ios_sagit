{
  "soc": "SDM835 / MSM8998",
  "board": "Xiaomi Mi 6 / sagit",
  "cpu": {
    "model": "Kryo 280",
    "mpidr": [
      0,
      1,
      2,
      3,
      256,
      257,
      258,
      259
    ],
    "clusters": 2,
    "cores_per_cluster": 4,
    "kernel_isa": "armv8-a+crc+crypto",
    "kernel_page_size": 4096,
    "kernel_pa_bits": 40,
    "runtime_feature_validation_required": true
  },
  "interrupts": {
    "controller": "GICv3",
    "gicd_base": "0x17a00000",
    "gicd_size": "0x10000",
    "gicr_base": "0x17b00000",
    "gicr_size": "0x100000",
    "redistributor_stride": "0x20000",
    "timer_intid": 27,
    "ipi_intid": 0,
    "group": "Group1NS"
  },
  "timer": {
    "frequency_hz": 19200000,
    "registers": "CNTVCT_EL0 / CNTV_CVAL_EL0 / CNTV_CTL_EL0"
  },
  "psci": {
    "conduit": "smc",
    "cpu_on64": "0xc4000003",
    "cpu_off": "0x84000002"
  },
  "uart": {
    "compatible": "qcom,msm-uartdm-v1.4",
    "console_base": "0x0c1b0000",
    "size": "0x1000",
    "spi": 114,
    "intid": 146,
    "mode": "8N1; polling; firmware baud retained",
    "pins": [
      "GPIO4",
      "GPIO5"
    ],
    "pin_function": "blsp_uart8_a",
    "clocks": "GCC BLSP2 UART2 apps + BLSP2 AHB, initialized by loader"
  },
  "memory": {
    "dram_base": "0x80000000",
    "dram_size": "must be supplied by the actual device loader",
    "upstream_reserved_examples": [
