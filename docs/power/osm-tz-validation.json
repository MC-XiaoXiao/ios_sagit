    "efi_bridge": "build passed; contract2, initial DT version0, CPU count8",
    "warnings": "Existing DTS simple_bus_reg/unique_unit_address warnings; collection verifier has no errors or warnings."
  },
  "remaining_limit": {
    "protected_post_init_completion": "Unobserved: TZ post-table clock/fuse setup can fail after the eight parameters are written, and its caller ignores failure.",
    "candidate_marker": "Both OSM banks +0x1050 receive0x179d4020 late in post-init. They are outside SCM permissions; nonsecure direct-read permission is unproven. No bypass read was added.",
    "retained_prerequisite": "Successful original TZ protected post-init and XBL CPU PLL/mux setup. Table compatibility is not full firmware attestation or proof of this prerequisite.",
