+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include <Uefi.h>
+#include <Library/UefiLib.h>
+EFI_STATUS EFIAPI ProbeEntry(EFI_HANDLE Handle, EFI_SYSTEM_TABLE *SystemTable) {
+  if (SystemTable == NULL || SystemTable->ConOut == NULL) return EFI_NOT_READY;
+  Print(L"FASTBOOT_EFI_PAYLOAD_OK\r\n");
+  return EFI_SUCCESS;
+}
