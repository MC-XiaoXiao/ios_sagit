@@ -445,7 +445,11 @@ FastbootAppEntryPoint (
   EFI_SIMPLE_TEXT_INPUT_PROTOCOL  *TextIn;
   EFI_INPUT_KEY                   Key;
 
+Restart:
   mDataBuffer = NULL;
+  mState = ExpectCmdState;
+  mNumDataBytes = mBytesReceivedSoFar = 0;
+  mRunEfi = FALSE;
 
   Status = gBS->LocateProtocol (
