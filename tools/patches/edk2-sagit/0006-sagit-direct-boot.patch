diff --git a/Platforms/Msm8998FamilyPkg/Library/PlatformBootManagerLib/XnuBoot.c b/Platforms/Msm8998FamilyPkg/Library/PlatformBootManagerLib/XnuBoot.c
index 802fa6c..3a7189a 100644
--- a/Platforms/Msm8998FamilyPkg/Library/PlatformBootManagerLib/XnuBoot.c
+++ b/Platforms/Msm8998FamilyPkg/Library/PlatformBootManagerLib/XnuBoot.c
@@ -45,22 +45,26 @@ STATIC BOOLEAN Mi6CancelBoot(UINT32 Seconds) {
   EFI_HANDLE *Handles=NULL;
   UINTN Count=0, Index, Tick;
   EFI_INPUT_KEY Key;
-  gBS->LocateHandleBuffer(ByProtocol,&gEfiSimpleTextInputExProtocolGuid,NULL,&Count,&Handles);
-  Print(L"\r\nMi 6: EDK2 -> XnuBridge -> XNU\r\nPress a volume key for USB Fastboot.\r\n");
-  for (Tick=0;Tick<Seconds*10;Tick++) {
-    if (Tick%10==0) Print(L"Starting XNU in %u seconds...\r\n",Seconds-Tick/10);
+  if (EFI_ERROR(gBS->LocateHandleBuffer(ByProtocol,&gEfiSimpleTextInputExProtocolGuid,NULL,&Count,&Handles)))
+    Count=0;
+  if (Seconds) Print(L"\r\nMi 6: EDK2 -> XnuBridge -> XNU\r\nPress a volume key for USB Fastboot.\r\n");
+  // Zero delay still checks held/queued recovery keys, without a timer wait.
+  for (Tick=0;;Tick++) {
     for (Index=0;Index<Count;Index++) {
       EFI_SIMPLE_TEXT_INPUT_EX_PROTOCOL *Input;
       EFI_KEY_DATA Data;
       if (!EFI_ERROR(gBS->HandleProtocol(Handles[Index],&gEfiSimpleTextInputExProtocolGuid,(VOID **)&Input)) &&
           !EFI_ERROR(Input->ReadKeyStrokeEx(Input,&Data))) {
-        FreePool(Handles); return TRUE;
+        if (Handles) FreePool(Handles);
+        return TRUE;
       }
     }
     if (gST->ConIn && !EFI_ERROR(gST->ConIn->ReadKeyStroke(gST->ConIn,&Key))) {
       if (Handles) FreePool(Handles);
       return TRUE;
     }
+    if (Tick>=Seconds*10) break;
+    if (Tick%10==0) Print(L"Starting XNU in %u seconds...\r\n",Seconds-Tick/10);
     gBS->Stall(100000);
   }
   if (Handles) FreePool(Handles);
@@ -82,7 +86,8 @@ EFI_STATUS Mi6BootPayload(VOID) {
   if (Bytes<sizeof(Header)) return EFI_COMPROMISED_DATA;
   Status=Disk->ReadDisk(Disk,MediaId,0,sizeof(Header),Header);
   if (EFI_ERROR(Status)) return Status;
-  if (CompareMem(Header+48,"sagit-mi6boot1",14)!=0) return EFI_NOT_FOUND;
+  if (CompareMem(Header+48,"sagit-mi6boot2",14)!=0 &&
+      CompareMem(Header+48,"sagit-mi6boot1",14)!=0) return EFI_NOT_FOUND;
   if (!Mi6RamdiskRange(Header,Bytes,&Offset,&RamdiskSize)) return EFI_NOT_FOUND;
   Status=Disk->ReadDisk(Disk,MediaId,Offset,sizeof(PayloadHeader),PayloadHeader);
   if (EFI_ERROR(Status)) return Status;
@@ -112,6 +117,9 @@ EFI_STATUS Mi6BootPayload(VOID) {
   } else CopyMem(Expanded,Stored,(UINTN)Payload.Expanded);
   Status=gBS->CalculateCrc32(Expanded,(UINTN)Payload.Expanded,&Crc);
   if (EFI_ERROR(Status) || Crc!=Payload.ExpandedCrc) { Status=EFI_CRC_ERROR; goto Done; }
+  // Disk I/O and decompression can take time. Catch recovery keys pressed
+  // while preparing the image as well, with no extra countdown.
+  if (Mi6CancelBoot(0)) { Status=EFI_ABORTED; goto Done; }
   Status=gBS->LoadImage(FALSE,gImageHandle,NULL,Expanded,(UINTN)Payload.Expanded,&Child);
   if (EFI_ERROR(Status)) goto Done;
   FreePool(Stored); Stored=NULL;
