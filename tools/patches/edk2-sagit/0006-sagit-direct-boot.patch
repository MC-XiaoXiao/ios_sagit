       ConIn, (EFI_DEVICE_PATH_PROTOCOL *)&mUsbKeyboard, NULL);

-  EFI_HANDLE *              handles;
-  UINTN                     NoHandles;
+  EFI_HANDLE *              handles = NULL;
+  UINTN                     NoHandles = 0;
+  UINTN                     InputIndex;
   EFI_DEVICE_PATH_PROTOCOL *devicehandle;
