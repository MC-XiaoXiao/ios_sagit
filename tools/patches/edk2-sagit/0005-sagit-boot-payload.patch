+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Android ramdisk payload packaging follows the UniXNU/sheng design. The
+// existing Mi 6 XnuBridge remains responsible for every hardware handoff.
+#ifdef MI6_BOOT_PAYLOAD_ENABLED
+#include <Uefi.h>
+#include "PlatformBm.h"
+#include <Protocol/BlockIo.h>
+#include <Protocol/DiskIo.h>
+#include <Protocol/PartitionInfo.h>
+#include <Protocol/SimpleTextInEx.h>
+#include "XnuBootFormat.h"
+
+// Public decoder entry points supplied by EDK2's LzmaCustomDecompressLib,
+// linked into sagit's BdsDxe as a NULL library instance.
+RETURN_STATUS EFIAPI LzmaUefiDecompressGetInfo(CONST VOID *, UINT32, UINT32 *, UINT32 *);
+RETURN_STATUS EFIAPI LzmaUefiDecompress(CONST VOID *, UINTN, VOID *, VOID *);
+
+STATIC EFI_STATUS Mi6FindBoot(EFI_DISK_IO_PROTOCOL **Io, UINT32 *MediaId, UINT64 *Bytes) {
+  EFI_HANDLE *Handles;
+  UINTN Count, Index;
+  EFI_STATUS Status;
+  *Io=NULL;
+  Status=gBS->LocateHandleBuffer(ByProtocol,&gEfiPartitionInfoProtocolGuid,NULL,&Count,&Handles);
+  if (EFI_ERROR(Status)) return Status;
+  for (Index=0;Index<Count;Index++) {
+    EFI_PARTITION_INFO_PROTOCOL *Part;
+    EFI_BLOCK_IO_PROTOCOL *Block;
+    EFI_DISK_IO_PROTOCOL *Disk;
+    if (EFI_ERROR(gBS->HandleProtocol(Handles[Index],&gEfiPartitionInfoProtocolGuid,(VOID **)&Part)) ||
+        Part->Type!=PARTITION_TYPE_GPT || StrnCmp(Part->Info.Gpt.PartitionName,L"boot",36)!=0) continue;
+    if (EFI_ERROR(gBS->HandleProtocol(Handles[Index],&gEfiBlockIoProtocolGuid,(VOID **)&Block)) ||
+        EFI_ERROR(gBS->HandleProtocol(Handles[Index],&gEfiDiskIoProtocolGuid,(VOID **)&Disk))) continue;
+    if (!Block->Media->MediaPresent || !Block->Media->LogicalPartition || Block->Media->RemovableMedia ||
+        !Block->Media->BlockSize || Block->Media->LastBlock==MAX_UINT64 ||
+        Block->Media->LastBlock+1>MAX_UINT64/Block->Media->BlockSize) continue;
+    if (*Io!=NULL) { FreePool(Handles); return EFI_COMPROMISED_DATA; }
+    *Io=Disk; *MediaId=Block->Media->MediaId;
+    *Bytes=(Block->Media->LastBlock+1)*Block->Media->BlockSize;
+  }
+  FreePool(Handles);
+  return *Io ? EFI_SUCCESS : EFI_NOT_FOUND;
+}
+
+STATIC BOOLEAN Mi6CancelBoot(UINT32 Seconds) {
+  EFI_HANDLE *Handles=NULL;
+  UINTN Count=0, Index, Tick;
+  EFI_INPUT_KEY Key;
+  gBS->LocateHandleBuffer(ByProtocol,&gEfiSimpleTextInputExProtocolGuid,NULL,&Count,&Handles);
+  Print(L"\r\nMi 6: EDK2 -> XnuBridge -> XNU\r\nPress a volume key for USB Fastboot.\r\n");
+  for (Tick=0;Tick<Seconds*10;Tick++) {
+    if (Tick%10==0) Print(L"Starting XNU in %u seconds...\r\n",Seconds-Tick/10);
+    for (Index=0;Index<Count;Index++) {
+      EFI_SIMPLE_TEXT_INPUT_EX_PROTOCOL *Input;
+      EFI_KEY_DATA Data;
+      if (!EFI_ERROR(gBS->HandleProtocol(Handles[Index],&gEfiSimpleTextInputExProtocolGuid,(VOID **)&Input)) &&
+          !EFI_ERROR(Input->ReadKeyStrokeEx(Input,&Data))) {
+        FreePool(Handles); return TRUE;
+      }
+    }
+    if (gST->ConIn && !EFI_ERROR(gST->ConIn->ReadKeyStroke(gST->ConIn,&Key))) {
+      if (Handles) FreePool(Handles);
+      return TRUE;
+    }
+    gBS->Stall(100000);
+  }
+  if (Handles) FreePool(Handles);
+  return FALSE;
+}
+
+EFI_STATUS Mi6BootPayload(VOID) {
+  EFI_DISK_IO_PROTOCOL *Disk;
+  EFI_STATUS Status;
+  EFI_HANDLE Child=NULL;
+  UINT8 Header[1632], PayloadHeader[64];
+  UINT8 *Stored=NULL, *Expanded=NULL;
+  VOID *Scratch=NULL;
+  UINT32 MediaId=0, RamdiskSize, Crc, DestinationSize, ScratchSize;
+  UINT64 Bytes=0, Offset;
+  MI6_BOOT_PAYLOAD Payload;
+  Status=Mi6FindBoot(&Disk,&MediaId,&Bytes);
+  if (EFI_ERROR(Status)) return Status;
+  if (Bytes<sizeof(Header)) return EFI_COMPROMISED_DATA;
+  Status=Disk->ReadDisk(Disk,MediaId,0,sizeof(Header),Header);
+  if (EFI_ERROR(Status)) return Status;
+  if (CompareMem(Header+48,"sagit-mi6boot1",14)!=0) return EFI_NOT_FOUND;
+  if (!Mi6RamdiskRange(Header,Bytes,&Offset,&RamdiskSize)) return EFI_NOT_FOUND;
+  Status=Disk->ReadDisk(Disk,MediaId,Offset,sizeof(PayloadHeader),PayloadHeader);
+  if (EFI_ERROR(Status)) return Status;
+  if (!Mi6PayloadHeader(PayloadHeader,RamdiskSize,&Payload)) return EFI_COMPROMISED_DATA;
+  if (!(Payload.Flags & 1)) return EFI_NOT_FOUND;
+  if (Mi6CancelBoot(Payload.Delay)) return EFI_ABORTED;
+  Stored=AllocatePool((UINTN)Payload.Stored);
+  Expanded=AllocatePool((UINTN)Payload.Expanded);
+  if (!Stored || !Expanded) { Status=EFI_OUT_OF_RESOURCES; goto Done; }
+  Status=Disk->ReadDisk(Disk,MediaId,Offset+64,(UINTN)Payload.Stored,Stored);
+  if (EFI_ERROR(Status)) goto Done;
+  Status=gBS->CalculateCrc32(Stored,(UINTN)Payload.Stored,&Crc);
+  if (EFI_ERROR(Status) || Crc!=Payload.StoredCrc) { Status=EFI_CRC_ERROR; goto Done; }
+  if (Payload.Flags & 2) {
+    // Accept only the bounded dictionary and the decoded size emitted by our packer.
+    if (CompareMem(Stored,"\x5d\x00\x00\x80\x00",5)!=0 || Mi6U64(Stored+5)!=Payload.Expanded) {
+      Status=EFI_COMPROMISED_DATA; goto Done;
+    }
+    Status=LzmaUefiDecompressGetInfo(Stored,(UINT32)Payload.Stored,&DestinationSize,&ScratchSize);
+    if (EFI_ERROR(Status) || DestinationSize!=Payload.Expanded || ScratchSize>0x100000) {
+      Status=EFI_COMPROMISED_DATA; goto Done;
+    }
+    Scratch=AllocatePool(MAX(ScratchSize,1));
+    if (!Scratch) { Status=EFI_OUT_OF_RESOURCES; goto Done; }
+    Status=LzmaUefiDecompress(Stored,(UINTN)Payload.Stored,Expanded,Scratch);
+    if (EFI_ERROR(Status)) goto Done;
+  } else CopyMem(Expanded,Stored,(UINTN)Payload.Expanded);
+  Status=gBS->CalculateCrc32(Expanded,(UINTN)Payload.Expanded,&Crc);
+  if (EFI_ERROR(Status) || Crc!=Payload.ExpandedCrc) { Status=EFI_CRC_ERROR; goto Done; }
+  Status=gBS->LoadImage(FALSE,gImageHandle,NULL,Expanded,(UINTN)Payload.Expanded,&Child);
+  if (EFI_ERROR(Status)) goto Done;
+  FreePool(Stored); Stored=NULL;
+  FreePool(Expanded); Expanded=NULL;
+  if (Scratch) { FreePool(Scratch); Scratch=NULL; }
+  Print(L"Starting bundled EFI payload...\r\n");
+  Status=gBS->StartImage(Child,NULL,NULL);
+Done:
+  if (Child) gBS->UnloadImage(Child);
+  if (Scratch) FreePool(Scratch);
+  if (Stored) FreePool(Stored);
+  if (Expanded) FreePool(Expanded);
+  return Status;
+}
+#endif
