+++ b/Platforms/Msm8998FamilyPkg/Drivers/QcomFastboot/QcomUsb.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// ABI subset of Qualcomm's BSD-licensed EFIUsbDevice.h, from
+// SHIFTPHONES/android_bootable_bootloader_edk2, QcomModulePkg/Include/Protocol.
+#include <IndustryStandard/Usb.h>
+typedef struct {
+  UINT32 Status;
+  UINT8 Endpoint;
+  UINTN Bytes;
+  VOID *Buffer;
+} QCOM_USB_TRANSFER;
+typedef union {
+  UINT32 State;
+  QCOM_USB_TRANSFER Transfer;
+  UINT8 Oem[64];
+} QCOM_USB_EVENT_DATA;
+#pragma pack(1)
+typedef struct {
+  UINT8 Length, Type;
+  UINT16 BcdUsb;
+  UINT8 Class, SubClass, Protocol, PacketSize, Configurations, Reserved;
+} QCOM_USB_QUALIFIER;
+#pragma pack()
+typedef struct {
+  UINTN Revision;
+  EFI_STATUS (EFIAPI *Start)(USB_DEVICE_DESCRIPTOR *, VOID **, QCOM_USB_QUALIFIER *, VOID *, UINT8, EFI_USB_STRING_DESCRIPTOR **);
+  EFI_STATUS (EFIAPI *Send)(UINT8, UINTN, VOID *);
+  EFI_STATUS (EFIAPI *HandleEvent)(UINT32 *, UINTN *, QCOM_USB_EVENT_DATA *);
+  EFI_STATUS (EFIAPI *Allocate)(UINTN, VOID **);
+  EFI_STATUS (EFIAPI *Free)(VOID *);
+  EFI_STATUS (EFIAPI *Stop)(VOID);
+  EFI_STATUS (EFIAPI *Abort)(UINT8);
+  EFI_STATUS (EFIAPI *Stall)(UINT8, BOOLEAN);
+  VOID *StartEx;
+} QCOM_USB;
+// USB configuration ABI: the first nine entries precede controller switching.
+typedef struct {
+  UINT32 Revision;
+  VOID *Legacy[9];
+  EFI_STATUS (EFIAPI *StartController)(VOID *, UINT32, UINT32);
+  EFI_STATUS (EFIAPI *StopController)(VOID *, UINT32, UINT32);
+  VOID *EnterLpm, *ExitLpm;
+  EFI_STATUS (EFIAPI *ToggleMode)(VOID *, UINT32);
+  VOID *GetCoreCount, *GetSupportedMode;
+  UINT32 Core, Mode;
+} QCOM_USB_CONFIG;
