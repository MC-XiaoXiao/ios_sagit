+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef MI6_BOOT_RAMDISK_H
+#define MI6_BOOT_RAMDISK_H
+
+#define MI6_BOOT_RAMDISK_HOB_GUID \
+  {0x297866da,0x926e,0x4625,{0xa6,0x6c,0x8f,0xf6,0xad,0x0f,0xbb,0xb9}}
+
+// The producer owns a page allocation containing a copy of the incoming
+// ramdisk. Presence, including a rejected ramdisk, takes precedence over disk.
+typedef struct {
+  UINT32 Version;
+  UINT32 Reserved;
+  UINT64 Status;
+  EFI_PHYSICAL_ADDRESS Base;
+  UINT64 Size;
+} MI6_BOOT_RAMDISK;
+
+#define MI6_BOOT_RAMDISK_MAX_SIZE 0x4000000ULL
+#endif
