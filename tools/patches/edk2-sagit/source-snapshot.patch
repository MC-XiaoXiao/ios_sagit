diff --git a/Platforms/Msm8998FamilyPkg/Drivers/QcomFastboot/QcomFastboot.c b/Platforms/Msm8998FamilyPkg/Drivers/QcomFastboot/QcomFastboot.c
new file mode 100644
index 0000000..3a89f97
--- /dev/null
+++ b/Platforms/Msm8998FamilyPkg/Drivers/QcomFastboot/QcomFastboot.c
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include <Uefi.h>
+#include <Protocol/AndroidFastbootTransport.h>
+#include <Protocol/AndroidFastbootPlatform.h>
+#include <Protocol/BlockIo.h>
+#include <Protocol/UsbFunctionIo.h>
+#include <Uefi/UefiGpt.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/PrintLib.h>
+#include <Library/UefiLib.h>
+#include <Library/PcdLib.h>
+#include "QcomUsb.h"
+
+#define RX_SIZE (1024 * 1024)
+STATIC EFI_GUID mUsbGuid = {0xd9d9ce48,0x44b8,0x4f49,{0x8e,0x3e,0x2a,0x3b,0x92,0x7d,0xc6,0xc1}};
+STATIC EFI_GUID mUsbInitGuid = {0x1c0cffce,0xfc8d,0x4e44,{0x8c,0x78,0x9c,0x9e,0x5b,0x53,0x0d,0x36}};
+STATIC QCOM_USB *mUsb;
+STATIC EFI_EVENT mTimer, mReceive;
+STATIC VOID *mRx, *mTx;
+STATIC BOOLEAN mRunning, mRxPending, mTxDone;
+STATIC UINTN mDownloadRemaining;
+STATIC LIST_ENTRY mPackets;
+typedef struct { LIST_ENTRY Link; UINTN Size; VOID *Data; } PACKET;
+#pragma pack(1)
+typedef struct {
+  USB_CONFIG_DESCRIPTOR Config;
+  USB_INTERFACE_DESCRIPTOR Interface;
+  USB_ENDPOINT_DESCRIPTOR In, Out;
+} CONFIG;
+#pragma pack()
+STATIC USB_DEVICE_DESCRIPTOR mDevice = {18,1,0x200,0,0,0,64,0x18d1,0xd00d,0x100,1,2,3,1};
+STATIC CONFIG mConfig = {{9,2,sizeof(CONFIG),1,1,0,0x80,250},{9,4,0,0,2,0xff,0x42,3,0},{7,5,0x81,2,512,0},{7,5,1,2,512,0}};
+STATIC QCOM_USB_QUALIFIER mQualifier = {10,6,0x200,0,0,0,64,1,0};
+STATIC CHAR16 mManufacturer[] = {0x0310,L'E',L'D',L'K',L'2',L' ',L'D',L'X'};
+STATIC CHAR16 mProduct[] = {0x031e,L'E',L'D',L'K',L'2',L' ',L'F',L'a',L's',L't',L'b',L'o',L'o',L't',L' '};
+STATIC CHAR16 mSerial[] = {0x031e,L'e',L'd',L'k',L'2',L'-',L'f',L'a',L's',L't',L'b',L'o',L'o',L't',L'1'};
+STATIC UINT16 mLanguage[] = {0x0304,0x0409};
+STATIC EFI_USB_STRING_DESCRIPTOR *mStrings[] = {(VOID *)mLanguage,(VOID *)mManufacturer,(VOID *)mProduct,(VOID *)mSerial};
+
+STATIC VOID QueueRx(VOID) {
+  UINTN Size=mDownloadRemaining ? MIN(mDownloadRemaining,RX_SIZE) : 64;
+  if (mRunning && !mRxPending && !EFI_ERROR(mUsb->Send(1, Size, mRx))) mRxPending = TRUE;
+}
+STATIC VOID Pump(VOID) {
+  UINT32 Event; UINTN Size; QCOM_USB_EVENT_DATA Data;
+  EFI_STATUS Status;
+  if (!mRunning) return;
+  Size = sizeof(Data); ZeroMem(&Data,sizeof(Data)); Event = 0;
+  Status = mUsb->HandleEvent(&Event, &Size, &Data);
+  if (EFI_ERROR(Status)) return;
+  if (Event == 1) {
+    if (Data.State == 0) QueueRx();
+    else mRxPending = FALSE;
+  } else if (Event == 2 && Data.Transfer.Status == 1) {
+    if (Data.Transfer.Endpoint == 0x81) mTxDone = TRUE;
+    else if (Data.Transfer.Endpoint == 1) {
+      PACKET *Packet;
+      mRxPending = FALSE;
+      if (Data.Transfer.Bytes != 0 && Data.Transfer.Bytes <= RX_SIZE) {
+        Packet = AllocateZeroPool(sizeof(*Packet));
+        if (mDownloadRemaining) mDownloadRemaining-=MIN(mDownloadRemaining,Data.Transfer.Bytes);
+        if (Packet != NULL) {
+          Packet->Data = AllocateCopyPool(Data.Transfer.Bytes, Data.Transfer.Buffer);
+          if (Packet->Data != NULL) {
+            Packet->Size = Data.Transfer.Bytes;
+            InsertTailList(&mPackets, &Packet->Link);
+            gBS->SignalEvent(mReceive);
+          } else FreePool(Packet);
+        }
+      }
+    }
+  }
+}
+STATIC VOID EFIAPI Tick(EFI_EVENT Event, VOID *Context) { Pump(); }
+STATIC VOID EFIAPI Dummy(EFI_EVENT Event, VOID *Context) { }
+STATIC EFI_STATUS ConnectPeripheral(VOID) {
+  EFI_STATUS Status;
+  EFI_USBFN_IO_PROTOCOL *Function;
+  QCOM_USB_CONFIG *Config;
+  EFI_HANDLE *Handles;
+  UINTN Count, Index;
+  EFI_GUID ConfigGuid = {0xe722b03f,0xb250,0x42ce,{0x8e,0xbd,0x5b,0xd5,0x18,0x12,0xd0,0x37}};
+
+  Status=gBS->LocateProtocol(&gEfiUsbFunctionIoProtocolGuid,NULL,(VOID **)&Function);
+  if (!EFI_ERROR(Status)) return EFI_SUCCESS;
+  Status=gBS->LocateProtocol(&ConfigGuid,NULL,(VOID **)&Config);
+  if (EFI_ERROR(Status)) return Status;
+  if (Config->Revision!=0x10002 && Config->Revision!=0x10003) return EFI_UNSUPPORTED;
+  Status=Config->StartController(Config,0,4);
+  Print(L"USB switch to peripheral: %r\r\n",Status);
+  Status=gBS->LocateProtocol(&gEfiUsbFunctionIoProtocolGuid,NULL,(VOID **)&Function);
+  if (!EFI_ERROR(Status)) return EFI_SUCCESS;
+
+  // Older firmware retains the detected host role in StartController even
+  // when peripheral mode is requested. Rebind the primary controller using
+  // the public USB_CONFIG core/mode fields consumed by DriverBindingSupported.
+  Status=gBS->LocateHandleBuffer(ByProtocol,&ConfigGuid,NULL,&Count,&Handles);
+  if (EFI_ERROR(Status)) return Status;
+  for (Index=0;Index<Count;Index++) {
+    UINT32 PreviousMode;
+    Status=gBS->HandleProtocol(Handles[Index],&ConfigGuid,(VOID **)&Config);
+    if (EFI_ERROR(Status) || (Config->Revision!=0x10002 && Config->Revision!=0x10003) || Config->Core!=0) continue;
+    Status=gBS->DisconnectController(Handles[Index],NULL,NULL);
+    if (EFI_ERROR(Status) && Status!=EFI_NOT_STARTED) continue;
+    PreviousMode=Config->Mode;
+    Config->Mode=4;
+    Status=gBS->ConnectController(Handles[Index],NULL,NULL,TRUE);
+    Print(L"USB Function bind core %u: %r\r\n",Config->Core,Status);
+    if (EFI_ERROR(Status)) {
+      Config->Mode=PreviousMode;
+      gBS->ConnectController(Handles[Index],NULL,NULL,TRUE);
+    }
+  }
+  FreePool(Handles);
+  Status=gBS->LocateProtocol(&gEfiUsbFunctionIoProtocolGuid,NULL,(VOID **)&Function);
+  Print(L"USB Function interface: %r\r\n",Status);
+  return Status;
+}
+STATIC EFI_STATUS Start(EFI_EVENT Receive) {
+  EFI_STATUS Status; EFI_EVENT InitEvent; VOID *Configs = &mConfig;
+  if (mRunning) return EFI_ALREADY_STARTED;
+  InitializeListHead(&mPackets); mReceive = Receive;
+  Status=ConnectPeripheral();
+  if (EFI_ERROR(Status)) return Status;
+  Status = gBS->LocateProtocol(&mUsbGuid,NULL,(VOID **)&mUsb);
+  Print(L"Qualcomm USB locate before init: %r\r\n", Status);
+  if (EFI_ERROR(Status)) {
+  Status = gBS->CreateEventEx(EVT_NOTIFY_SIGNAL,TPL_CALLBACK,Dummy,NULL,&mUsbInitGuid,&InitEvent);
+  if (EFI_ERROR(Status)) return Status;
+  gBS->SignalEvent(InitEvent); gBS->CloseEvent(InitEvent);
+  Status = gBS->LocateProtocol(&mUsbGuid,NULL,(VOID **)&mUsb);
+  if (EFI_ERROR(Status)) return Status;
+  }
+  Print(L"Qualcomm USB protocol ready\r\n");
+  Status = mUsb->Start(&mDevice,&Configs,&mQualifier,NULL,4,mStrings);
+  Print(L"Qualcomm USB Start: %r, revision %lx\r\n",Status,mUsb->Revision);
+  if (EFI_ERROR(Status)) return Status;
+  Status = mUsb->Allocate(RX_SIZE,&mRx);
+  Print(L"Qualcomm USB RX allocate: %r\r\n", Status);
+  if (EFI_ERROR(Status)) { mUsb->Stop(); return Status; }
+  Status = mUsb->Allocate(4096,&mTx);
+  if (EFI_ERROR(Status)) { mUsb->Free(mRx); mRx=NULL; mUsb->Stop(); return Status; }
+  mRunning=TRUE; mRxPending=FALSE; mDownloadRemaining=0;
+  Status=gBS->CreateEvent(EVT_TIMER|EVT_NOTIFY_SIGNAL,TPL_CALLBACK,Tick,NULL,&mTimer);
+  if (!EFI_ERROR(Status)) Status=gBS->SetTimer(mTimer,TimerPeriodic,10000);
+  return Status;
+}
+STATIC EFI_STATUS Stop(VOID) {
+  if (!mRunning) return EFI_SUCCESS;
+  mRunning=FALSE;
+  if (mTimer) { gBS->CloseEvent(mTimer); mTimer=NULL; }
+  mUsb->Abort(1); mUsb->Abort(0x81);
+  mUsb->Free(mRx); mUsb->Free(mTx); mRx=mTx=NULL;
+  mUsb->Stop();
+  while (!IsListEmpty(&mPackets)) {
+    PACKET *Packet=(PACKET *)GetFirstNode(&mPackets);
+    RemoveEntryList(&Packet->Link); FreePool(Packet->Data); FreePool(Packet);
+  }
+  return EFI_SUCCESS;
+}
+STATIC EFI_STATUS Send(UINTN Size, CONST VOID *Buffer, EFI_EVENT *Fatal) {
+  UINTN Budget=200000; EFI_STATUS Status;
+  if (!mRunning || Size>4096) return EFI_BAD_BUFFER_SIZE;
+  // Match the receive request to Fastboot's announced data length. Waiting
+  // for a short USB packet hangs when a download ends on a packet boundary.
+  if (Size==12 && CompareMem(Buffer,"DATA",4)==0) {
+    CHAR8 Hex[9];
+    CopyMem(Hex,(CONST UINT8 *)Buffer+4,8); Hex[8]=0;
+    mDownloadRemaining=AsciiStrHexToUintn(Hex);
+  }
+  CopyMem(mTx,Buffer,Size); mTxDone=FALSE;
+  Status=mUsb->Send(0x81,Size,mTx);
+  if (EFI_ERROR(Status)) return Status;
+  while (!mTxDone && --Budget) { Pump(); gBS->Stall(10); }
+  return mTxDone ? EFI_SUCCESS : EFI_TIMEOUT;
+}
+STATIC EFI_STATUS Receive(UINTN *Size, VOID **Buffer) {
+  PACKET *Packet;
+  if (IsListEmpty(&mPackets)) { QueueRx(); return EFI_NOT_READY; }
+  Packet=(PACKET *)GetFirstNode(&mPackets); RemoveEntryList(&Packet->Link);
+  *Size=Packet->Size; *Buffer=Packet->Data; FreePool(Packet);
+  return EFI_SUCCESS;
+}
+
+// Discover the named GPT partition on the actual UFS LUN; never hard-code LBAs.
+STATIC EFI_BLOCK_IO_PROTOCOL *mBootDisk;
+STATIC EFI_LBA mBootStart, mBootEnd;
+STATIC EFI_STATUS FindBoot(VOID) {
+  EFI_HANDLE *Handles; UINTN Count, Index; EFI_STATUS Status;
+  Status=gBS->LocateHandleBuffer(ByProtocol,&gEfiBlockIoProtocolGuid,NULL,&Count,&Handles);
+  if (EFI_ERROR(Status)) return Status;
+  mBootDisk=NULL;
+  for (Index=0;Index<Count;Index++) {
+    EFI_BLOCK_IO_PROTOCOL *Disk; EFI_PARTITION_TABLE_HEADER *Header;
+    VOID *Block, *Table; UINTN BlockSize, TableBytes, Pages, Entry;
+    UINT32 Crc, Saved; UINTN Alignment;
+    if (EFI_ERROR(gBS->HandleProtocol(Handles[Index],&gEfiBlockIoProtocolGuid,(VOID **)&Disk))) continue;
+    BlockSize=Disk->Media->BlockSize;
+    if (!Disk->Media->MediaPresent || Disk->Media->LogicalPartition || BlockSize<512 || BlockSize>4096) continue;
+    Alignment=MAX((UINTN)Disk->Media->IoAlign,(UINTN)EFI_PAGE_SIZE);
+    Block=AllocateAlignedPages(1,Alignment); if (!Block) continue;
+    Status=Disk->ReadBlocks(Disk,Disk->Media->MediaId,1,BlockSize,Block);
+    Header=Block;
+    if (EFI_ERROR(Status) || Header->Header.Signature!=EFI_PTAB_HEADER_ID || Header->Header.HeaderSize<92 || Header->Header.HeaderSize>BlockSize) { FreeAlignedPages(Block,1); continue; }
+    Saved=Header->Header.CRC32; Header->Header.CRC32=0;
+    gBS->CalculateCrc32(Header,Header->Header.HeaderSize,&Crc); Header->Header.CRC32=Saved;
+    if (Crc!=Saved || Header->NumberOfPartitionEntries>256 || Header->SizeOfPartitionEntry<sizeof(EFI_PARTITION_ENTRY) || Header->SizeOfPartitionEntry>512) { FreeAlignedPages(Block,1); continue; }
+    TableBytes=Header->NumberOfPartitionEntries*Header->SizeOfPartitionEntry;
+    if (!TableBytes) { FreeAlignedPages(Block,1); continue; }
+    Pages=EFI_SIZE_TO_PAGES(ALIGN_VALUE(TableBytes,BlockSize));
+    Table=AllocateAlignedPages(Pages,Alignment);
+    if (!Table) { FreeAlignedPages(Block,1); continue; }
+    Status=Disk->ReadBlocks(Disk,Disk->Media->MediaId,Header->PartitionEntryLBA,ALIGN_VALUE(TableBytes,BlockSize),Table);
+    if (!EFI_ERROR(Status)) {
+      gBS->CalculateCrc32(Table,TableBytes,&Crc);
+      if (Crc==Header->PartitionEntryArrayCRC32) for (Entry=0;Entry<Header->NumberOfPartitionEntries;Entry++) {
+        EFI_PARTITION_ENTRY *Part=(VOID *)((UINT8 *)Table+Entry*Header->SizeOfPartitionEntry);
+        if (Part->PartitionName[0]==L'b' && Part->PartitionName[1]==L'o' && Part->PartitionName[2]==L'o' && Part->PartitionName[3]==L't' && Part->PartitionName[4]==0 && Part->StartingLBA>=Header->FirstUsableLBA && Part->EndingLBA<=Header->LastUsableLBA && Part->StartingLBA<=Part->EndingLBA) {
+          if (mBootDisk) { FreeAlignedPages(Table,Pages); FreeAlignedPages(Block,1); FreePool(Handles); return EFI_COMPROMISED_DATA; }
+          mBootDisk=Disk; mBootStart=Part->StartingLBA; mBootEnd=Part->EndingLBA;
+        }
+      }
+    }
+    FreeAlignedPages(Table,Pages); FreeAlignedPages(Block,1);
+  }
+  FreePool(Handles);
+  return mBootDisk ? EFI_SUCCESS : EFI_NOT_FOUND;
+}
+STATIC EFI_STATUS Init(VOID) { return EFI_SUCCESS; }
+STATIC VOID UnInit(VOID) { }
+STATIC EFI_STATUS Flash(CHAR8 *Name, UINTN Size, VOID *Data) {
+  EFI_STATUS Status; UINTN BlockSize, Bytes, Pages; VOID *Write, *Read;
+  UINT32 KernelSize, RamdiskSize, SecondSize, PageSize, HeaderVersion;
+  UINT64 Required;
+  if (AsciiStrCmp(Name,"boot")!=0) return EFI_ACCESS_DENIED;
+  if (Size<1632 || CompareMem(Data,"ANDROID!",8)!=0) return EFI_INVALID_PARAMETER;
+  CopyMem(&KernelSize,(UINT8 *)Data+8,4);
+  CopyMem(&RamdiskSize,(UINT8 *)Data+16,4);
+  CopyMem(&SecondSize,(UINT8 *)Data+24,4);
+  CopyMem(&PageSize,(UINT8 *)Data+36,4);
+  CopyMem(&HeaderVersion,(UINT8 *)Data+40,4);
+  if (!KernelSize || HeaderVersion!=0 || (PageSize!=2048 && PageSize!=4096)) return EFI_UNSUPPORTED;
+  Required=PageSize+ALIGN_VALUE((UINT64)KernelSize,PageSize)+ALIGN_VALUE((UINT64)RamdiskSize,PageSize)+ALIGN_VALUE((UINT64)SecondSize,PageSize);
+  if (Required>Size) return EFI_BAD_BUFFER_SIZE;
+  Status=FindBoot(); if (EFI_ERROR(Status)) return Status;
+  BlockSize=mBootDisk->Media->BlockSize; Bytes=ALIGN_VALUE(Size,BlockSize);
+  if (Bytes>(mBootEnd-mBootStart+1)*BlockSize || mBootDisk->Media->ReadOnly) return EFI_BAD_BUFFER_SIZE;
+  Pages=EFI_SIZE_TO_PAGES(Bytes);
+  Write=AllocateAlignedPages(Pages,MAX((UINTN)mBootDisk->Media->IoAlign,(UINTN)EFI_PAGE_SIZE));
+  Read=AllocateAlignedPages(Pages,MAX((UINTN)mBootDisk->Media->IoAlign,(UINTN)EFI_PAGE_SIZE));
+  if (!Write || !Read) { if (Write) FreeAlignedPages(Write,Pages); if (Read) FreeAlignedPages(Read,Pages); return EFI_OUT_OF_RESOURCES; }
+  ZeroMem(Write,Bytes); CopyMem(Write,Data,Size);
+  Status=mBootDisk->WriteBlocks(mBootDisk,mBootDisk->Media->MediaId,mBootStart,Bytes,Write);
+  if (!EFI_ERROR(Status)) Status=mBootDisk->FlushBlocks(mBootDisk);
+  if (!EFI_ERROR(Status)) Status=mBootDisk->ReadBlocks(mBootDisk,mBootDisk->Media->MediaId,mBootStart,Bytes,Read);
+  if (!EFI_ERROR(Status) && CompareMem(Write,Read,Bytes)!=0) Status=EFI_CRC_ERROR;
+  Print(L"Fastboot flash boot + readback: %r (%u bytes)\r\n",Status,Size);
+  FreeAlignedPages(Write,Pages); FreeAlignedPages(Read,Pages); return Status;
+}
+STATIC EFI_STATUS Erase(CHAR8 *Name) { return EFI_UNSUPPORTED; }
+STATIC EFI_STATUS GetVar(CHAR8 *Name, CHAR8 *Value) {
+  Value[0]=0;
+  if (!AsciiStrCmp(Name,"product")) AsciiStrCpyS(Value,61,(CHAR8 *)PcdGetPtr(PcdDeviceCodeName));
+  else if (!AsciiStrCmp(Name,"serialno")) AsciiStrCpyS(Value,61,"edk2-fastboot1");
+  else if (!AsciiStrCmp(Name,"version-bootloader")) AsciiStrCpyS(Value,61,"edk2-fastboot-1");
+  else if (!AsciiStrCmp(Name,"max-download-size")) AsciiStrCpyS(Value,61,"0x04000000");
+  else if (!AsciiStrCmp(Name,"partition-size:boot")) {
+    EFI_STATUS Status=FindBoot(); if (EFI_ERROR(Status)) return Status;
+    AsciiSPrint(Value,61,"0x%lx",(mBootEnd-mBootStart+1)*mBootDisk->Media->BlockSize);
+  }
+  return EFI_SUCCESS;
+}
+STATIC EFI_STATUS Oem(CHAR8 *Command) { return EFI_UNSUPPORTED; }
+STATIC FASTBOOT_TRANSPORT_PROTOCOL mTransport={Start,Stop,Send,Receive};
+STATIC FASTBOOT_PLATFORM_PROTOCOL mPlatform={Init,UnInit,Flash,Erase,GetVar,Oem};
+EFI_STATUS EFIAPI QcomFastbootEntry(EFI_HANDLE Handle, EFI_SYSTEM_TABLE *SystemTable) {
+  return gBS->InstallMultipleProtocolInterfaces(&Handle,&gAndroidFastbootTransportProtocolGuid,&mTransport,&gAndroidFastbootPlatformProtocolGuid,&mPlatform,NULL);
+}
