diff --git a/Platforms/Msm8998FamilyPkg/Library/FrameBufferSerialPortLib/QcomUartDm.h b/Platforms/Msm8998FamilyPkg/Library/FrameBufferSerialPortLib/QcomUartDm.h
new file mode 100644
index 0000000..4095f6a
--- /dev/null
+++ b/Platforms/Msm8998FamilyPkg/Library/FrameBufferSerialPortLib/QcomUartDm.h
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Polled UARTDM v1.4 console. Stock firmware owns clocks, pinmux and divisor.
+#include <Library/IoLib.h>
+
+#define UART_BASE 0x0C1B0000
+#define UART_SR 0x08
+#define UART_CR 0x10
+#define UART_ISR 0x14
+#define UART_DMRX 0x34
+#define UART_FIFO 0x70
+#define UART_RX_LIMIT 0xFFFFFF
+STATIC UINT32 mRxWord, mRxCount, mRxConsumed, mRxRemaining;
+STATIC BOOLEAN mStaleRequested;
+
+STATIC UINT32 UartRead(UINTN Reg) { return MmioRead32(UART_BASE + Reg); }
+STATIC VOID UartWrite(UINTN Reg, UINT32 Value) {
+  MmioWrite32(UART_BASE + Reg, Value);
+  __asm__ volatile("dsb sy" ::: "memory");
+}
+
+STATIC VOID UartInit(VOID) {
+  UartWrite(0x14, 0); // Interrupt mask
+  UartWrite(0x3C, 0); // DMA disabled
+  UartWrite(UART_CR, 0x0A);
+  UartWrite(UART_CR, 0x10); // Reset RX
+  UartWrite(UART_CR, 0x20); // Reset TX
+  UartWrite(UART_CR, 0x30); // Reset errors
+  UartWrite(UART_CR, 0x600); // Disable automatic stale events
+  UartWrite(UART_CR, 0x80);
+  UartWrite(0, 0); // No hardware flow control
+  UartWrite(4, 0x34); // 8N1
+  UartWrite(0x18, 1);
+  UartWrite(0x20, 0);
+  UartWrite(0x1C, 0);
+  UartWrite(UART_DMRX, UART_RX_LIMIT);
+  UartWrite(UART_CR, 5); // RX + TX enable
+  mRxCount = mRxConsumed = mRxRemaining = 0;
+  mStaleRequested = FALSE;
+}
+
+STATIC BOOLEAN UartPut(UINT8 Byte) {
+  UINTN Budget = 1000000;
+  while (!(UartRead(UART_SR) & 8)) {
+    if (--Budget == 0) return FALSE;
+    __asm__ volatile("yield");
+  }
+  UartWrite(0x40, 1); // NCF_TX: one byte, one FIFO word
+  (VOID)UartRead(0x40);
+  Budget = 1000000;
+  while (!(UartRead(UART_SR) & 4)) {
+    if (--Budget == 0) return FALSE;
+    __asm__ volatile("yield");
+  }
+  UartWrite(UART_FIFO, Byte);
+  return TRUE;
+}
+
+STATIC BOOLEAN UartPoll(VOID) {
+  UINT32 Status, Snapshot;
+  if (mRxCount != 0) return TRUE;
+  Status = UartRead(UART_SR);
+  if (Status & 0x10) UartWrite(UART_CR, 0x30);
+  if (!mStaleRequested && (Status & 1)) {
+    mRxWord = UartRead(UART_FIFO);
+    mRxCount = 4;
+    mRxConsumed += 4;
+    return TRUE;
+  }
+  if (!mStaleRequested) {
+    if (((UartRead(0x50) >> 7) & 7) == 0) return FALSE;
+    UartWrite(UART_CR, 0x400); // Flush a partial FIFO word
+    mStaleRequested = TRUE;
+  }
+  if (!(UartRead(UART_ISR) & 8)) return FALSE;
+  if (mRxRemaining == 0) {
+    Snapshot = UartRead(0x38);
+    if (Snapshot < mRxConsumed || Snapshot > UART_RX_LIMIT) {
+      UartInit();
+      return FALSE;
+    }
+    mRxRemaining = Snapshot - mRxConsumed;
+  }
+  if (mRxRemaining != 0) {
+    mRxWord = UartRead(UART_FIFO);
+    mRxCount = MIN(mRxRemaining, 4);
+    mRxRemaining -= mRxCount;
+    mRxConsumed += mRxCount;
+  }
+  if (mRxRemaining == 0) {
+    UartWrite(UART_CR, 0x80);
+    UartWrite(UART_DMRX, UART_RX_LIMIT);
+    mRxConsumed = 0;
+    mStaleRequested = FALSE;
+  }
+  return mRxCount != 0;
+}
diff --git a/Platforms/Msm8998FamilyPkg/Library/PlatformBootManagerLib/XnuBoot.c b/Platforms/Msm8998FamilyPkg/Library/PlatformBootManagerLib/XnuBoot.c
new file mode 100644
index 0000000..0a54173
--- /dev/null
+++ b/Platforms/Msm8998FamilyPkg/Library/PlatformBootManagerLib/XnuBoot.c
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Android ramdisk payload packaging follows the UniXNU/sheng design. The
+// existing Mi 6 XnuBridge remains responsible for every hardware handoff.
+#ifdef MI6_BOOT_PAYLOAD_ENABLED
+#include <PiDxe.h>
+#include "PlatformBm.h"
+#include <Protocol/BlockIo.h>
+#include <Protocol/DiskIo.h>
+#include <Protocol/PartitionInfo.h>
+#include <Protocol/SimpleTextInEx.h>
+#include <Library/HobLib.h>
+#include <Guid/Mi6BootRamdisk.h>
+#include "XnuBootFormat.h"
+
+// Public decoder entry points supplied by EDK2's LzmaCustomDecompressLib,
+// linked into sagit's BdsDxe as a NULL library instance.
+RETURN_STATUS EFIAPI LzmaUefiDecompressGetInfo(CONST VOID *, UINT32, UINT32 *, UINT32 *);
+RETURN_STATUS EFIAPI LzmaUefiDecompress(CONST VOID *, UINTN, VOID *, VOID *);
+
+STATIC EFI_STATUS Mi6MemoryPayload(CONST UINT8 **Memory, UINT32 *Size, BOOLEAN *Present) {
+  STATIC CONST EFI_GUID Guid=MI6_BOOT_RAMDISK_HOB_GUID;
+  VOID *Hob=GetFirstGuidHob(&Guid);
+  MI6_BOOT_RAMDISK Record;
+  *Memory=NULL; *Size=0; *Present=(Hob!=NULL);
+  if (!Hob) return EFI_SUCCESS;
+  if (GET_GUID_HOB_DATA_SIZE(Hob)!=sizeof(Record)) return EFI_COMPROMISED_DATA;
+  CopyMem(&Record,GET_GUID_HOB_DATA(Hob),sizeof(Record));
+  if (Record.Version!=1 || Record.Reserved) return EFI_COMPROMISED_DATA;
+  if (EFI_ERROR((EFI_STATUS)Record.Status)) return (EFI_STATUS)Record.Status;
+  if (!Record.Base || (Record.Base & EFI_PAGE_MASK) || Record.Size<64 ||
+      Record.Size>MI6_BOOT_RAMDISK_MAX_SIZE || Record.Base>(1ULL<<48)-Record.Size)
+    return EFI_COMPROMISED_DATA;
+  *Memory=(VOID *)(UINTN)Record.Base; *Size=(UINT32)Record.Size;
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_STATUS Mi6FindBoot(EFI_DISK_IO_PROTOCOL **Io, UINT32 *MediaId, UINT64 *Bytes) {
+  EFI_HANDLE *Handles;
+  UINTN Count, Index;
+  EFI_STATUS Status;
+  *Io=NULL;
+  Status=gBS->LocateHandleBuffer(ByProtocol,&gEfiPartitionInfoProtocolGuid,NULL,&Count,&Handles);
+  if (EFI_ERROR(Status)) return Status;
+  for (Index=0;Index<Count;Index++) {
+    EFI_PARTITION_INFO_PROTOCOL *Part;
+    EFI_BLOCK_IO_PROTOCOL *Block;
+    EFI_DISK_IO_PROTOCOL *Disk;
+    if (EFI_ERROR(gBS->HandleProtocol(Handles[Index],&gEfiPartitionInfoProtocolGuid,(VOID **)&Part)) ||
+        Part->Type!=PARTITION_TYPE_GPT || StrnCmp(Part->Info.Gpt.PartitionName,L"boot",36)!=0) continue;
+    if (EFI_ERROR(gBS->HandleProtocol(Handles[Index],&gEfiBlockIoProtocolGuid,(VOID **)&Block)) ||
+        EFI_ERROR(gBS->HandleProtocol(Handles[Index],&gEfiDiskIoProtocolGuid,(VOID **)&Disk))) continue;
+    if (!Block->Media->MediaPresent || !Block->Media->LogicalPartition || Block->Media->RemovableMedia ||
+        !Block->Media->BlockSize || Block->Media->LastBlock==MAX_UINT64 ||
+        Block->Media->LastBlock+1>MAX_UINT64/Block->Media->BlockSize) continue;
+    if (*Io!=NULL) { FreePool(Handles); return EFI_COMPROMISED_DATA; }
+    *Io=Disk; *MediaId=Block->Media->MediaId;
+    *Bytes=(Block->Media->LastBlock+1)*Block->Media->BlockSize;
+  }
+  FreePool(Handles);
+  return *Io ? EFI_SUCCESS : EFI_NOT_FOUND;
+}
+
+STATIC BOOLEAN Mi6CancelBoot(UINT32 Seconds) {
+  EFI_HANDLE *Handles=NULL;
+  UINTN Count=0, Index, Tick;
+  EFI_INPUT_KEY Key;
+  if (EFI_ERROR(gBS->LocateHandleBuffer(ByProtocol,&gEfiSimpleTextInputExProtocolGuid,NULL,&Count,&Handles)))
+    Count=0;
+  if (Seconds) Print(L"\r\nMi 6: EDK2 -> XnuBridge -> XNU\r\nPress a volume key for USB Fastboot.\r\n");
+  // Zero delay still checks held/queued recovery keys, without a timer wait.
+  for (Tick=0;;Tick++) {
+    for (Index=0;Index<Count;Index++) {
+      EFI_SIMPLE_TEXT_INPUT_EX_PROTOCOL *Input;
+      EFI_KEY_DATA Data;
+      if (!EFI_ERROR(gBS->HandleProtocol(Handles[Index],&gEfiSimpleTextInputExProtocolGuid,(VOID **)&Input)) &&
+          !EFI_ERROR(Input->ReadKeyStrokeEx(Input,&Data))) {
+        if (Handles) FreePool(Handles);
+        return TRUE;
+      }
+    }
+    if (gST->ConIn && !EFI_ERROR(gST->ConIn->ReadKeyStroke(gST->ConIn,&Key))) {
+      if (Handles) FreePool(Handles);
+      return TRUE;
+    }
+    if (Tick>=Seconds*10) break;
+    if (Tick%10==0) Print(L"Starting XNU in %u seconds...\r\n",Seconds-Tick/10);
+    gBS->Stall(100000);
+  }
+  if (Handles) FreePool(Handles);
+  return FALSE;
+}
+
+EFI_STATUS Mi6BootPayload(VOID) {
+  EFI_DISK_IO_PROTOCOL *Disk=NULL;
+  EFI_STATUS Status;
+  EFI_HANDLE Child=NULL;
+  UINT8 Header[1632], PayloadHeader[64];
+  UINT8 *Stored=NULL, *Expanded=NULL;
+  VOID *Scratch=NULL;
+  UINT32 MediaId=0, RamdiskSize, Crc, DestinationSize, ScratchSize;
+  UINT64 Bytes=0, Offset=0;
+  CONST UINT8 *Memory;
+  BOOLEAN MemoryPresent;
+  MI6_BOOT_PAYLOAD Payload;
+  Status=Mi6MemoryPayload(&Memory,&RamdiskSize,&MemoryPresent);
+  if (EFI_ERROR(Status)) return Status;
+  if (MemoryPresent) {
+    Print(L"XNU payload source: incoming ramdisk (%u bytes)\r\n",RamdiskSize);
+    CopyMem(PayloadHeader,Memory,sizeof(PayloadHeader));
+  } else {
+    Status=Mi6FindBoot(&Disk,&MediaId,&Bytes);
+    if (EFI_ERROR(Status)) return Status;
+    if (Bytes<sizeof(Header)) return EFI_COMPROMISED_DATA;
+    Status=Disk->ReadDisk(Disk,MediaId,0,sizeof(Header),Header);
+    if (EFI_ERROR(Status)) return Status;
+    if (CompareMem(Header+48,"sagit-mi6boot3",14)!=0 &&
+        CompareMem(Header+48,"sagit-mi6boot2",14)!=0 &&
+        CompareMem(Header+48,"sagit-mi6boot1",14)!=0) return EFI_NOT_FOUND;
+    if (!Mi6RamdiskRange(Header,Bytes,&Offset,&RamdiskSize)) return EFI_NOT_FOUND;
+    Status=Disk->ReadDisk(Disk,MediaId,Offset,sizeof(PayloadHeader),PayloadHeader);
+    if (EFI_ERROR(Status)) return Status;
+    Print(L"XNU payload source: boot partition (%u bytes)\r\n",RamdiskSize);
+  }
+  if (!Mi6PayloadHeader(PayloadHeader,RamdiskSize,&Payload)) return EFI_COMPROMISED_DATA;
+  if (!(Payload.Flags & 1)) return EFI_NOT_FOUND;
+  if (Mi6CancelBoot(Payload.Delay)) return EFI_ABORTED;
+  Stored=AllocatePool((UINTN)Payload.Stored);
+  Expanded=AllocatePool((UINTN)Payload.Expanded);
+  if (!Stored || !Expanded) { Status=EFI_OUT_OF_RESOURCES; goto Done; }
+  if (MemoryPresent) {
+    CopyMem(Stored,Memory+64,(UINTN)Payload.Stored);
+    Status=EFI_SUCCESS;
+  } else Status=Disk->ReadDisk(Disk,MediaId,Offset+64,(UINTN)Payload.Stored,Stored);
+  if (EFI_ERROR(Status)) goto Done;
+  Status=gBS->CalculateCrc32(Stored,(UINTN)Payload.Stored,&Crc);
+  if (EFI_ERROR(Status) || Crc!=Payload.StoredCrc) { Status=EFI_CRC_ERROR; goto Done; }
+  if (Payload.Flags & 2) {
+    // Accept only the bounded dictionary and the decoded size emitted by our packer.
+    if (CompareMem(Stored,"\x5d\x00\x00\x80\x00",5)!=0 || Mi6U64(Stored+5)!=Payload.Expanded) {
+      Status=EFI_COMPROMISED_DATA; goto Done;
+    }
+    Status=LzmaUefiDecompressGetInfo(Stored,(UINT32)Payload.Stored,&DestinationSize,&ScratchSize);
+    if (EFI_ERROR(Status) || DestinationSize!=Payload.Expanded || ScratchSize>0x100000) {
+      Status=EFI_COMPROMISED_DATA; goto Done;
+    }
+    Scratch=AllocatePool(MAX(ScratchSize,1));
+    if (!Scratch) { Status=EFI_OUT_OF_RESOURCES; goto Done; }
+    Status=LzmaUefiDecompress(Stored,(UINTN)Payload.Stored,Expanded,Scratch);
+    if (EFI_ERROR(Status)) goto Done;
+  } else CopyMem(Expanded,Stored,(UINTN)Payload.Expanded);
+  Status=gBS->CalculateCrc32(Expanded,(UINTN)Payload.Expanded,&Crc);
+  if (EFI_ERROR(Status) || Crc!=Payload.ExpandedCrc) { Status=EFI_CRC_ERROR; goto Done; }
+  // Disk I/O and decompression can take time. Catch recovery keys pressed
+  // while preparing the image as well, with no extra countdown.
+  if (Mi6CancelBoot(0)) { Status=EFI_ABORTED; goto Done; }
+  Status=gBS->LoadImage(FALSE,gImageHandle,NULL,Expanded,(UINTN)Payload.Expanded,&Child);
+  if (EFI_ERROR(Status)) goto Done;
+  FreePool(Stored); Stored=NULL;
+  FreePool(Expanded); Expanded=NULL;
+  if (Scratch) { FreePool(Scratch); Scratch=NULL; }
+  Print(L"Starting bundled EFI payload...\r\n");
+  Status=gBS->StartImage(Child,NULL,NULL);
+Done:
+  if (Child) gBS->UnloadImage(Child);
+  if (Scratch) FreePool(Scratch);
+  if (Stored) FreePool(Stored);
+  if (Expanded) FreePool(Expanded);
+  return Status;
+}
+#endif
diff --git a/Platforms/Msm8998FamilyPkg/Library/PlatformBootManagerLib/XnuBootFormat.h b/Platforms/Msm8998FamilyPkg/Library/PlatformBootManagerLib/XnuBootFormat.h
new file mode 100644
index 0000000..429ed95
--- /dev/null
+++ b/Platforms/Msm8998FamilyPkg/Library/PlatformBootManagerLib/XnuBootFormat.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// MI6BOOT1 is little-endian and independent of the host structure alignment.
+#ifndef MI6_XNU_BOOT_FORMAT_H
+#define MI6_XNU_BOOT_FORMAT_H
+
+typedef struct {
+  UINT32 Flags;
+  UINT32 Delay;
+  UINT64 Stored;
+  UINT64 Expanded;
+  UINT32 StoredCrc;
+  UINT32 ExpandedCrc;
+} MI6_BOOT_PAYLOAD;
+
+STATIC UINT32 Mi6U32(CONST UINT8 *P) {
+  return (UINT32)P[0] | ((UINT32)P[1]<<8) | ((UINT32)P[2]<<16) | ((UINT32)P[3]<<24);
+}
+STATIC UINT64 Mi6U64(CONST UINT8 *P) {
+  return Mi6U32(P) | ((UINT64)Mi6U32(P+4)<<32);
+}
+STATIC BOOLEAN Mi6PayloadHeader(CONST UINT8 *P, UINT64 RamdiskSize, MI6_BOOT_PAYLOAD *Out) {
+  UINTN Index;
+  CONST CHAR8 Magic[8] = {'M','I','6','B','O','O','T','1'};
+  if (RamdiskSize < 64) return FALSE;
+  for (Index=0;Index<8;Index++) if (P[Index] != (UINT8)Magic[Index]) return FALSE;
+  if (Mi6U32(P+8)!=1 || Mi6U32(P+12)!=64) return FALSE;
+  Out->Flags=Mi6U32(P+16); Out->Delay=Mi6U32(P+20);
+  Out->Stored=Mi6U64(P+24); Out->Expanded=Mi6U64(P+32);
+  Out->StoredCrc=Mi6U32(P+40); Out->ExpandedCrc=Mi6U32(P+44);
+  if ((Out->Flags & ~3U) || Out->Delay>30 ||
+      Out->Stored<13 || Out->Stored>0x4000000 || Out->Stored!=RamdiskSize-64 ||
+      Out->Expanded<64 || Out->Expanded>0x10000000) return FALSE;
+  for (Index=48;Index<64;Index++) if (P[Index]) return FALSE;
+  if (!(Out->Flags & 2) && Out->Stored!=Out->Expanded) return FALSE;
+  return TRUE;
+}
+STATIC BOOLEAN Mi6RamdiskRange(CONST UINT8 *P, UINT64 PartitionBytes, UINT64 *Offset, UINT32 *Size) {
+  UINT32 Kernel=Mi6U32(P+8), Page=Mi6U32(P+36);
+  if (Mi6U64(P)!=0x2144494f52444e41ULL || !Kernel || Mi6U32(P+24) ||
+      Mi6U32(P+40) || (Page!=2048 && Page!=4096)) return FALSE;
+  *Offset=Page+(((UINT64)Kernel+Page-1)&~((UINT64)Page-1));
+  *Size=Mi6U32(P+16);
+  return *Size>=64 && *Size<=0x4000000 && *Offset<=PartitionBytes &&
+         (((UINT64)*Size+Page-1)&~((UINT64)Page-1))<=PartitionBytes-*Offset;
+}
+#endif
