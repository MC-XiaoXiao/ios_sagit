diff --git a/Platforms/Msm8998FamilyPkg/MemoryInitPei/XnuBootRamdisk.h b/Platforms/Msm8998FamilyPkg/MemoryInitPei/XnuBootRamdisk.h
new file mode 100644
index 0000000..e9b8208
--- /dev/null
+++ b/Platforms/Msm8998FamilyPkg/MemoryInitPei/XnuBootRamdisk.h
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef MI6_PREPI_RAMDISK_H
+#define MI6_PREPI_RAMDISK_H
+#include <Guid/Mi6BootRamdisk.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/HobLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/PlatformMemoryMapLib.h>
+#include <libfdt.h>
+
+STATIC UINT64 Mi6FdtInteger(CONST UINT8 *Data, INT32 Length) {
+  UINT64 Value=0;
+  while (Length--) Value=(Value<<8)|*Data++;
+  return Value;
+}
+
+STATIC EFI_STATUS Mi6InitrdRange(CONST VOID *Fdt, UINT64 *Base, UINT64 *Size, BOOLEAN *Present) {
+  INT32 Node, StartLength=0, EndLength=0;
+  CONST UINT8 *Start, *End;
+  UINT64 Limit;
+  *Base=*Size=0; *Present=FALSE;
+  if (fdt_check_header(Fdt)) { *Present=TRUE; return EFI_COMPROMISED_DATA; }
+  Node=fdt_path_offset(Fdt,"/chosen");
+  if (Node==-FDT_ERR_NOTFOUND) return EFI_NOT_FOUND;
+  if (Node<0) { *Present=TRUE; return EFI_COMPROMISED_DATA; }
+  Start=fdt_getprop(Fdt,Node,"linux,initrd-start",&StartLength);
+  End=fdt_getprop(Fdt,Node,"linux,initrd-end",&EndLength);
+  if (!Start && !End && StartLength==-FDT_ERR_NOTFOUND && EndLength==-FDT_ERR_NOTFOUND)
+    return EFI_NOT_FOUND;
+  *Present=TRUE;
+  if (!Start || !End || (StartLength!=4 && StartLength!=8) || (EndLength!=4 && EndLength!=8))
+    return EFI_COMPROMISED_DATA;
+  *Base=Mi6FdtInteger(Start,StartLength); Limit=Mi6FdtInteger(End,EndLength);
+  if (!*Base && !Limit) { *Present=FALSE; return EFI_NOT_FOUND; }
+  if (!*Base || Limit<=*Base || Limit>(1ULL<<48) || Limit-*Base>MI6_BOOT_RAMDISK_MAX_SIZE)
+    return EFI_COMPROMISED_DATA;
+  *Size=Limit-*Base;
+  return EFI_SUCCESS;
+}
+
+STATIC BOOLEAN Mi6RangesOverlap(UINT64 Base, UINT64 Size, UINT64 Other, UINT64 Bytes) {
+  // Subtraction avoids overflowing either end of an untrusted range.
+  return Size && Bytes && (Base<=Other ? Other-Base<Size : Base-Other<Bytes);
+}
+
+STATIC BOOLEAN Mi6InitrdSourceValid(
+  CONST ARM_MEMORY_REGION_DESCRIPTOR_EX *Map, DeviceMemoryAddHob Selected,
+  UINT64 Base, UINT64 Size, UINT64 UefiBase, UINT64 UefiSize,
+  UINT64 FdBase, UINT64 FdSize, UINT64 FdtStore) {
+  BOOLEAN Covered=FALSE;
+  if (!Size || Size>MI6_BOOT_RAMDISK_MAX_SIZE || Base>MAX_UINT64-Size ||
+      Mi6RangesOverlap(Base,Size,UefiBase,UefiSize) ||
+      Mi6RangesOverlap(Base,Size,FdBase,FdSize) ||
+      Mi6RangesOverlap(Base,Size,FdtStore,sizeof(UINT64))) return FALSE;
+  for (;Map->Length;Map++) {
+    if ((Map->HobOption==Mem4G || Map->HobOption==Mem6G || Map->HobOption==Mem8G) &&
+        Map->HobOption!=Selected) continue;
+    if (!Mi6RangesOverlap(Base,Size,Map->Address,Map->Length)) continue;
+    if (Map->ResourceType!=EFI_RESOURCE_SYSTEM_MEMORY ||
+        (Map->MemoryType!=EfiConventionalMemory && Map->MemoryType!=EfiBootServicesData)) return FALSE;
+    if (Map->HobOption!=NoHob && Base>=Map->Address && Base-Map->Address<=Map->Length &&
+        Size<=Map->Length-(Base-Map->Address)) Covered=TRUE;
+  }
+  return Covered;
+}
+
+STATIC VOID Mi6PreserveRamdisk(
+  CONST VOID *Fdt, CONST ARM_MEMORY_REGION_DESCRIPTOR_EX *Map, DeviceMemoryAddHob Selected,
+  UINT64 UefiBase, UINT64 UefiSize, UINT64 FdBase, UINT64 FdSize, UINT64 FdtStore) {
+  STATIC CONST EFI_GUID Guid=MI6_BOOT_RAMDISK_HOB_GUID;
+  UINT64 Base, Size;
+  BOOLEAN Present;
+  EFI_STATUS Status=Mi6InitrdRange(Fdt,&Base,&Size,&Present);
+  MI6_BOOT_RAMDISK *Record;
+  VOID *Copy;
+  if (!Present) return;
+  Record=BuildGuidHob(&Guid,sizeof(*Record));
+  if (!Record) CpuDeadLoop();
+  ZeroMem(Record,sizeof(*Record)); Record->Version=1; Record->Status=EFI_COMPROMISED_DATA;
+  if (EFI_ERROR(Status)) return;
+  if (!Mi6InitrdSourceValid(Map,Selected,Base,Size,UefiBase,UefiSize,FdBase,FdSize,FdtStore)) return;
+  // A foreign initrd must not cause execution of a different on-disk payload.
+  if (Size<64 || CompareMem((VOID *)(UINTN)Base,"MI6BOOT1",8)) {
+    Record->Status=EFI_NOT_FOUND;
+    return;
+  }
+  // PrePi AllocatePages emits an allocation HOB. The copy remains owned across
+  // DXE allocations and FDT reuse until the bridge exits boot services.
+  Copy=AllocatePages(EFI_SIZE_TO_PAGES(Size));
+  if (!Copy) { Record->Status=EFI_OUT_OF_RESOURCES; return; }
+  CopyMem(Copy,(VOID *)(UINTN)Base,(UINTN)Size);
+  Record->Base=(UINTN)Copy; Record->Size=Size; Record->Status=EFI_SUCCESS;
+}
+#endif
