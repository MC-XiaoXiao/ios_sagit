diff --git a/Platforms/Msm8998FamilyPkg/Library/FrameBufferSerialPortLib/SagitUart.h b/Platforms/Msm8998FamilyPkg/Library/FrameBufferSerialPortLib/SagitUart.h
new file mode 100644
--- /dev/null
+++ b/Platforms/Msm8998FamilyPkg/Library/FrameBufferSerialPortLib/SagitUart.h
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Polled UARTDM v1.4 console. Stock firmware owns clocks, pinmux and divisor.
+#include <Library/IoLib.h>
+
+#define UART_BASE 0x0C1B0000
+#define UART_SR 0x08
+#define UART_CR 0x10
+#define UART_ISR 0x14
+#define UART_DMRX 0x34
+#define UART_FIFO 0x70
+#define UART_RX_LIMIT 0xFFFFFF
+STATIC UINT32 mRxWord, mRxCount, mRxConsumed, mRxRemaining;
+STATIC BOOLEAN mStaleRequested;
+
+STATIC UINT32 UartRead(UINTN Reg) { return MmioRead32(UART_BASE + Reg); }
+STATIC VOID UartWrite(UINTN Reg, UINT32 Value) {
+  MmioWrite32(UART_BASE + Reg, Value);
+  __asm__ volatile("dsb sy" ::: "memory");
+}
+
+STATIC VOID UartInit(VOID) {
+  UartWrite(0x14, 0); // Interrupt mask
+  UartWrite(0x3C, 0); // DMA disabled
+  UartWrite(UART_CR, 0x0A);
+  UartWrite(UART_CR, 0x10); // Reset RX
+  UartWrite(UART_CR, 0x20); // Reset TX
+  UartWrite(UART_CR, 0x30); // Reset errors
+  UartWrite(UART_CR, 0x600); // Disable automatic stale events
+  UartWrite(UART_CR, 0x80);
+  UartWrite(0, 0); // No hardware flow control
+  UartWrite(4, 0x34); // 8N1
+  UartWrite(0x18, 1);
+  UartWrite(0x20, 0);
+  UartWrite(0x1C, 0);
+  UartWrite(UART_DMRX, UART_RX_LIMIT);
+  UartWrite(UART_CR, 5); // RX + TX enable
+  mRxCount = mRxConsumed = mRxRemaining = 0;
+  mStaleRequested = FALSE;
+}
+
+STATIC BOOLEAN UartPut(UINT8 Byte) {
+  UINTN Budget = 1000000;
+  while (!(UartRead(UART_SR) & 8)) {
+    if (--Budget == 0) return FALSE;
+    __asm__ volatile("yield");
+  }
+  UartWrite(0x40, 1); // NCF_TX: one byte, one FIFO word
+  (VOID)UartRead(0x40);
+  Budget = 1000000;
+  while (!(UartRead(UART_SR) & 4)) {
+    if (--Budget == 0) return FALSE;
+    __asm__ volatile("yield");
+  }
+  UartWrite(UART_FIFO, Byte);
+  return TRUE;
+}
+
+STATIC BOOLEAN UartPoll(VOID) {
+  UINT32 Status, Snapshot;
+  if (mRxCount != 0) return TRUE;
+  Status = UartRead(UART_SR);
+  if (Status & 0x10) UartWrite(UART_CR, 0x30);
+  if (!mStaleRequested && (Status & 1)) {
+    mRxWord = UartRead(UART_FIFO);
+    mRxCount = 4;
+    mRxConsumed += 4;
+    return TRUE;
+  }
+  if (!mStaleRequested) {
+    if (((UartRead(0x50) >> 7) & 7) == 0) return FALSE;
+    UartWrite(UART_CR, 0x400); // Flush a partial FIFO word
+    mStaleRequested = TRUE;
+  }
+  if (!(UartRead(UART_ISR) & 8)) return FALSE;
+  if (mRxRemaining == 0) {
+    Snapshot = UartRead(0x38);
+    if (Snapshot < mRxConsumed || Snapshot > UART_RX_LIMIT) {
+      UartInit();
+      return FALSE;
+    }
+    mRxRemaining = Snapshot - mRxConsumed;
+  }
+  if (mRxRemaining != 0) {
+    mRxWord = UartRead(UART_FIFO);
+    mRxCount = MIN(mRxRemaining, 4);
+    mRxRemaining -= mRxCount;
+    mRxConsumed += mRxCount;
+  }
+  if (mRxRemaining == 0) {
+    UartWrite(UART_CR, 0x80);
+    UartWrite(UART_DMRX, UART_RX_LIMIT);
+    mRxConsumed = 0;
+    mStaleRequested = FALSE;
+  }
+  return mRxCount != 0;
+}
