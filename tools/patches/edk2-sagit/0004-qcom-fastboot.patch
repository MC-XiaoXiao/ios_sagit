@@ -9,8 +9,8 @@
 #include <Resources/FbColor.h>
 
 #include "FrameBufferSerialPortLib.h"
-#ifdef SAGIT_UART_CONSOLE
-#include "SagitUart.h"
+#ifdef QCOM_UARTDM_CONSOLE
+#include "QcomUartDm.h"
