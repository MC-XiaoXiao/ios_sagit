+// CheckpointAreaBlocks reserves room for successive writable checkpoints. The
+// stable transaction must remain intact while its successor is built; free
+// queues can also grow beyond the formatter's initially empty roots. Eight data
+// blocks fit two initial four-block checkpoints, but cannot commit a successor
+// that needs five blocks (native APFS returns ENOSPC even on an empty volume).
+// Scale the reserve with the container, bounded for large images, and leave at
+// least four copies of the caller's ephemeral-object growth budget.
+func CheckpointAreaBlocks(blockCount uint64, ephemeralBlocks uint32) (desc, data uint32) {
+	desc = uint32(max(uint64(8), min(uint64(256), blockCount/4096)))
+	desc = (desc + 7) &^ 7
+	data = uint32(max(uint64(32), min(uint64(32768), blockCount/256)))
+	data = max(data, 4*ephemeralBlocks)
+	data = (data + 7) &^ 7
+	return
+}
 
