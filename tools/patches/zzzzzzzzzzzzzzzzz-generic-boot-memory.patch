+/* Optional firmware RAM whitelist. Absent on the normal contiguous boot ABI. */
+static uint64_t boot_memory_ranges[256][2];
+static unsigned int boot_memory_count;
+static uint64_t boot_memory_bootstrap_end;
+
+bool pmap_boot_memory_contains(pmap_paddr_t pa);
+bool
+pmap_boot_memory_contains(pmap_paddr_t pa)
+{
+	if (!boot_memory_count) {
+		return true;
+	}
+	unsigned int lo = 0, hi = boot_memory_count;
+	while (lo < hi) {
+		unsigned int mid = lo + (hi - lo) / 2;
+		if (pa < boot_memory_ranges[mid][0]) {
+			hi = mid;
+		} else if (pa >= boot_memory_ranges[mid][1]) {
+			lo = mid + 1;
+		} else {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+boot_memory_init(boot_args *args)
+{
+	DTEntry chosen;
+	void const *property;
+	unsigned int bytes;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "boot-memory-count", &property, &bytes) != kSuccess) {
+		return;
+	}
+	if (bytes != sizeof(boot_memory_count)) {
+		panic("Boot memory: invalid count");
+	}
+	memcpy(&boot_memory_count, property, bytes);
+	if (!boot_memory_count) {
+		return;
+	}
+	if (boot_memory_count > 256 ||
+	    SecureDTGetProperty(chosen, "boot-memory-ranges", &property, &bytes) != kSuccess ||
+	    bytes < boot_memory_count * 16) {
+		panic("Boot memory: invalid ranges");
+	}
+	memcpy(boot_memory_ranges, property, boot_memory_count * 16);
+	uint64_t total = 0, end = args->physBase;
+	for (unsigned int i = 0; i < boot_memory_count; i++) {
+		uint64_t start = boot_memory_ranges[i][0], length = boot_memory_ranges[i][1];
+		if (start < end || !length || ((start | length) & PAGE_MASK) ||
+		    start > UINT64_MAX - length || start + length > (1ULL << 48)) {
+			panic("Boot memory: invalid range %u", i);
+		}
+		end = start + length;
+		boot_memory_ranges[i][1] = end;
+		total += length;
+	}
+	if (total != args->memSizeActual || boot_memory_ranges[0][0] != args->physBase ||
+	    SecureDTGetProperty(chosen, "boot-memory-bootstrap-end", &property, &bytes) != kSuccess || bytes != 8) {
+		panic("Boot memory: invalid totals/bootstrap range");
+	}
+	memcpy(&boot_memory_bootstrap_end, property, bytes);
+	if (boot_memory_bootstrap_end > boot_memory_ranges[0][1] ||
+	    boot_memory_bootstrap_end <= args->topOfKernelData ||
+	    boot_memory_bootstrap_end != args->physBase + args->memSize) {
+		panic("Boot memory: bootstrap crosses reserved RAM");
+	}
+	/* The initial assembly tables cover the contiguous bootstrap allocation.
+	 * Expand only when the VM is ready to build the full physical aperture. */
+	args->memSize = end - args->physBase;
+}
