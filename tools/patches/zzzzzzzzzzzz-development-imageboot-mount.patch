 extern "C" {
+/* Resolve a volume UUID, optionally restricted to an ancestor media device. */
+int
+di_volume_name(const char *parent_devname, const char *volume_uuid,
+    char *devname, size_t devsz)
+{
+	OSDictionary *matching = IOService::serviceMatching("IOMedia");
+	OSDictionary *properties = OSDictionary::withCapacity(1);
+	OSString *identifier = OSString::withCString(volume_uuid);
+	OSIterator *iterator = NULL;
+	IOReturn result = kIOReturnNoMemory;
+	if (matching && properties && identifier &&
+	    properties->setObject("UUID", identifier) &&
+	    matching->setObject("IOPropertyMatch", properties)) {
+		iterator = IOService::getMatchingServices(matching);
+		result = kIOReturnNotFound;
+	}
+	if (iterator) {
+		while (IOService *media = OSDynamicCast(IOService, iterator->getNextObject())) {
+			OSString *name = OSDynamicCast(OSString, media->getProperty("BSD Name"));
+			if (!name) {
+				continue;
+			}
+			for (IOService *parent = media; parent; parent = parent->getProvider()) {
+				OSString *ancestor = OSDynamicCast(OSString, parent->getProperty("BSD Name"));
+				if (!parent_devname || (ancestor && ancestor->isEqualTo(parent_devname))) {
+					result = strlcpy(devname, name->getCStringNoCopy(), devsz) < devsz ?
+					    kIOReturnSuccess : kIOReturnNoSpace;
+					break;
+				}
+			}
+			if (result != kIOReturnNotFound) {
+				break;
+			}
+		}
+		iterator->release();
+	}
+	if (identifier) identifier->release();
+	if (properties) properties->release();
+	if (matching) matching->release();
+	return result;
+}
