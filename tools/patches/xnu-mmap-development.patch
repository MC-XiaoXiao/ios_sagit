diff --git a/security/mac_file.c b/security/mac_file.c
--- a/security/mac_file.c
+++ b/security/mac_file.c
@@ -46,6 +46,38 @@
 #include <sys/file_internal.h>
 
 #include <security/mac_internal.h>
+#include <pexpert/pexpert.h>
+
+#if (DEVELOPMENT || DEBUG) && !SECURE_KERNEL
+/* Explicit, path-scoped console diagnostics on a debugger-enabled boot. */
+static boolean_t
+mac_file_development_mmap_allowed(struct fileglob *fg)
+{
+	char allowed[MAXPATHLEN];
+	char path[MAXPATHLEN];
+	int path_size = sizeof(path);
+	struct vnode *vp;
+	int error;
+
+	if (!PE_i_can_has_debugger(NULL) ||
+	    !PE_parse_boot_argn("development-sandbox-mmap-path", allowed, sizeof(allowed)) ||
+	    allowed[0] != '/' || !fg || FILEGLOB_DTYPE(fg) != DTYPE_VNODE) {
+		return FALSE;
+	}
+	allowed[sizeof(allowed) - 1] = '\0';
+	vp = (struct vnode *)fg_get_data(fg);
+	if (vnode_getwithref(vp) != 0) {
+		return FALSE;
+	}
+	error = vn_getpath(vp, path, &path_size);
+	vnode_put(vp);
+	if (error || strcmp(path, allowed) != 0) {
+		return FALSE;
+	}
+	printf("mmap development allowance: Sandbox path=%s\n", path);
+	return TRUE;
+}
+#endif
 
 int
 mac_file_check_create(struct ucred *cred)
@@ -178,7 +210,30 @@
 	int maxp;
 
 	maxp = *maxprot;
-	MAC_CHECK(file_check_mmap, cred, fg, NULL, prot, flags, offset, &maxp);
+#if DEVELOPMENT || DEBUG
+	int trace = 0;
+	boolean_t development_allow = FALSE;
+#if !SECURE_KERNEL
+	development_allow = mac_file_development_mmap_allowed(fg);
+#endif
+	PE_parse_boot_argn("mmap-failure-trace", &trace, sizeof(trace));
+	if (trace || development_allow) {
+		error = 0;
+		MAC_POLICY_ITERATE({
+			if (mpc->mpc_ops->mpo_file_check_mmap != NULL &&
+			    !(development_allow && strcmp(mpc->mpc_name, "Sandbox") == 0)) {
+				MAC_CHECK_CALL(file_check_mmap, mpc);
+				int __step_err = mpc->mpc_ops->mpo_file_check_mmap(cred, fg, NULL, prot, flags, offset, &maxp);
+				MAC_CHECK_RSLT(file_check_mmap, mpc);
+				if (trace && __step_err) printf("mmap denial: policy=%s errno=%d\n", mpc->mpc_name, __step_err);
+				error = mac_error_select(__step_err, error);
+			}
+		});
+	} else
+#endif
+	{
+		MAC_CHECK(file_check_mmap, cred, fg, NULL, prot, flags, offset, &maxp);
+	}
