diff --git a/pkg/apfswrite/cow.go b/pkg/apfswrite/cow.go
new file mode 100644
index 0000000..e973f74
--- /dev/null
+++ b/pkg/apfswrite/cow.go
@@ -0,0 +1,34 @@
+package apfswrite
+
+import (
+	"fmt"
+	"sort"
+)
+
+type blockRange struct{ start, end uint64 }
+
+func (b *builder) validateReuse() error {
+	if b.cowMetadataBase == 0 {
+		return nil
+	}
+	sort.Slice(b.reusedRanges, func(i, j int) bool { return b.reusedRanges[i].start < b.reusedRanges[j].start })
+	var merged []blockRange
+	for _, r := range b.reusedRanges {
+		if r.start < 1 || r.end > b.cowMetadataBase {
+			return fmt.Errorf("retained extent overlaps COW metadata")
+		}
+		if len(merged) > 0 {
+			prev := &merged[len(merged)-1]
+			if r.start < prev.end {
+				return fmt.Errorf("overlapping retained extents/clones unsupported")
+			}
+			if r.start == prev.end {
+				prev.end = r.end
+				continue
+			}
+		}
+		merged = append(merged, r)
+	}
+	b.reusedRanges = merged
+	return nil
+}
