+#endif
+}
+
+#if (DEVELOPMENT || DEBUG) && !SECURE_KERNEL
+/* The inherited label remains owned by the ordinary credential machinery. */
+static boolean_t
+mac_vnode_development_exec_allowed(struct vnode *vp)
+{
+	char allowed[MAXPATHLEN];
+	char path[MAXPATHLEN];
+	int path_size = sizeof(path);
+	int error;
+
+	if (!PE_i_can_has_debugger(NULL) ||
+	    !PE_parse_boot_argn("development-sandbox-exec-path", allowed, sizeof(allowed)) ||
+	    allowed[0] != '/' || !vp || vnode_getwithref(vp) != 0) {
+		return FALSE;
+	}
+	allowed[sizeof(allowed) - 1] = '\0';
+	error = vn_getpath(vp, path, &path_size);
+	vnode_put(vp);
+	if (error) {
+		return FALSE;
+	}
+	/* A colon-separated list still matches each complete absolute vnode path. */
+	for (char *entry = allowed, *next; entry && *entry; entry = next) {
+		next = strchr(entry, ':');
+		if (next) {
+			*next++ = '\0';
+		}
+		if (entry[0] == '/' && strcmp(path, entry) == 0) {
+			printf("exec development allowance: Sandbox label update path=%s\n", path);
+			return TRUE;
+		}
+	}
+	return FALSE;
+}
+#endif
