+static void
+mac_exec_hook_trace(const char *policy, const char *stage, int result)
+{
+#if DEVELOPMENT || DEBUG
+	int trace = 0;
+	if (PE_parse_boot_argn("process-exec-trace", &trace, sizeof(trace)) && trace >= 3) {
+		printf("MAC exec hook trace: pid=%d policy=%s stage=%s result=%d\n",
+		    proc_selfpid(), policy, stage, result);
