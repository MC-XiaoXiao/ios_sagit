+kern_return_t
+sched_perfcontrol_register_callbacks_exclusive(sched_perfcontrol_callbacks_t callbacks, unsigned long size_of_state)
+{
+    if (!callbacks || callbacks->version != SCHED_PERFCONTROL_CALLBACKS_VERSION_5 ||
+        size_of_state > sizeof(struct perfcontrol_state)) {
+        return KERN_INVALID_ARGUMENT;
+    }
+    lck_mtx_lock(&perfcontrol_registration_lock);
