+void
+sched_perfcontrol_register_callbacks(sched_perfcontrol_callbacks_t callbacks, unsigned long size_of_state)
+{
+    // Preserve the Apple registration API. An explicit legacy registration
+    // supersedes an exclusive claimant, which can observe ownership loss.
+    lck_mtx_lock(&perfcontrol_registration_lock);
+    os_atomic_store(&perfcontrol_registration_owner, NULL, release);
+    sched_perfcontrol_install_callbacks(callbacks, size_of_state);
+    lck_mtx_unlock(&perfcontrol_registration_lock);
