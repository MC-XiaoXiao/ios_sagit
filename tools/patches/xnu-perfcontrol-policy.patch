+kern_return_t
+sched_perfcontrol_cpu_state(unsigned int cpu, perfcontrol_class_t *perfclass, boolean_t *online)
+{
+    if (!perfclass || !online || cpu >= MAX_SCHED_CPUS) return KERN_INVALID_ARGUMENT;
+    processor_t processor = processor_array[cpu];
+    if (processor == PROCESSOR_NULL) return KERN_INVALID_ARGUMENT;
+    processor_set_t pset = processor->processor_set;
+    boolean_t interrupts = ml_set_interrupts_enabled(FALSE);
+    pset_lock(pset);
+    *online = processor->state >= PROCESSOR_IDLE;
+    *perfclass = processor->state == PROCESSOR_RUNNING ? processor->current_perfctl_class : PERFCONTROL_CLASS_IDLE;
+    pset_unlock(pset);
+    ml_set_interrupts_enabled(interrupts);
+    return KERN_SUCCESS;
 }
 
 
